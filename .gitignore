# 项目内的环境、工具和缓存
/.venv/
/.tools/
/.cache/
__pycache__/
*.py[cod]
*.egg-info/
/build/
/dist/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# 验证脚本及产物仅临时使用，目录说明保留。
/tests/*
!/tests/README.md

# 跟踪原始数据说明和来源记录，忽略数据文件。
/dataset/.archives/
/dataset/raw/*
!/dataset/raw/README.md
!/dataset/raw/*/
/dataset/raw/*/*
!/dataset/raw/*/source.json

# 模型权重和二进制实验产物
*.pt
*.pth
*.pth.tar
*.ckpt
*.safetensors
*.onnx
*.npy
*.npz
*.pkl
*.pickle
*.h5
*.hdf5
*.bin
*.tar
*.tar.gz
*.tgz
*.zip
events.out.tfevents.*

# 本地凭据和临时文件
.env
.env.*
!.env.example
*.log
*.tmp
*.part
*.swp
*.swo
*~
.DS_Store
Thumbs.db
